# Environment variables — copy to .env (local) or Vercel/Actions secrets (deployed)
# Never commit the real .env file (in .gitignore).

# --- Alpaca (PAPER only — from Paper dashboard, not Live) ---
# SERVER-SIDE ONLY
ALPACA_API_KEY_ID=your_paper_key_id_here
ALPACA_API_SECRET_KEY=your_paper_secret_here
# Same keys work for market data API (SIP historical when bar end >15 min ago)
# Optional: DATA_SOURCE=yfinance for offline local bars (default is alpaca)

# --- Supabase ---
# URL and anon key may appear in browser bundle for auth client
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
# SERVICE ROLE: server-side only — never expose to browser or commit
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
# Optional direct Postgres URL for migrations/engine
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
# STATE_BACKEND=auto|postgres|file|memory  (auto → Postgres if DATABASE_URL set)
# STATE_BACKEND=file

# --- Resend (email) — SERVER-SIDE ONLY ---
RESEND_API_KEY=re_xxxxxxxx
NOTIFY_EMAIL_TO=you@example.com
# Prefer a verified domain (e.g. you@yourdomain.com). onboarding@resend.dev
# only delivers to the Resend account owner's inbox.
NOTIFY_EMAIL_FROM=bot@your-verified-domain.com
# Optional link in digest / alerts
# DASHBOARD_URL=https://your-app.vercel.app

# --- Bot operation flags (deployed) ---
# Shadow week default: journal + state, never submit_order
BOT_SHADOW_MODE=true
# Submit: place paper orders only when shadow is false
BOT_SUBMIT=false
# Leveraged-trend engine (QLD). Stage A REJECT — keep shadow/submit-off until gate pass.
BOT_SHADOW_MODE_LEV_TREND=true
BOT_SUBMIT_LEV_TREND=false
# Vercel Cron / manual poke auth (set in Vercel; optional locally)
# CRON_SECRET=
# ALLOW_UNAUTH_CRON=true   # local only — never in Vercel/Actions

# --- Next.js dashboard (also set on Vercel; use .env.local locally) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
# Local mutations call Python actions inline when not on Vercel:
# ENGINE_INLINE=1
# On Vercel, Next proxies to /api/engine_* with CRON_SECRET.
# Optional override for engine base URL:
# ENGINE_BASE_URL=https://your-app.vercel.app
