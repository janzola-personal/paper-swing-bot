# Environment variables — copy to .env (local) or Vercel/Actions secrets (deployed)
# Never commit the real .env file (in .gitignore).

# --- Alpaca (PAPER only — from Paper dashboard, not Live) ---
# SERVER-SIDE ONLY
ALPACA_API_KEY_ID=your_paper_key_id_here
ALPACA_API_SECRET_KEY=your_paper_secret_here
# Same keys work for market data API (SIP historical when bar end >15 min ago)

# --- Supabase ---
# URL and anon key may appear in browser bundle for auth client
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
# SERVICE ROLE: server-side only — never expose to browser or commit
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
# Optional direct Postgres URL for migrations/engine
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# --- Resend (email) — SERVER-SIDE ONLY ---
RESEND_API_KEY=re_xxxxxxxx
NOTIFY_EMAIL_TO=you@example.com
NOTIFY_EMAIL_FROM=bot@your-verified-domain.com

# --- Bot operation flags (deployed) ---
# Shadow: full logic, journal, no orders
BOT_SHADOW_MODE=false
# Submit: place paper orders when false shadow and not paused
BOT_SUBMIT=false

# --- Next.js (web/.env.local) ---
# NEXT_PUBLIC_SUPABASE_URL=${SUPABASE_URL}
# NEXT_PUBLIC_SUPABASE_ANON_KEY=${SUPABASE_ANON_KEY}
